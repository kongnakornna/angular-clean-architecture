COMPOSE_ENV_FILE=.env.dev

SERVER_APP_VERSION=v0.0.1
SERVER_PORT=5000
SERVER_MODE=Development
SERVER_PROCESS_TIMEOUT=60
SERVER_READ_TIMEOUT=5
SERVER_WRITE_TIMEOUT=5

LOGGER_ENCODING=console
LOGGER_LEVEL=debug

# For container use – must be service name 'db'
# Example .env.dev
DB_HOST=192.168.1.41
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=icmongolang

REDIS_HOST=192.168.1.41
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_MACHINE_TOPIC=machine-events
KAFKA_SENSOR_TOPIC=sensor-events
KAFKA_GROUP_ID=icmon-consumer-group
KAFKA_TIMEOUT=30

POSTGRES_CONNECTION_TIMEOUT=10

TASK_REDIS_POOL_TIMEOUT=240

SMTP_EMAIL_TIMEOUT=30

INFLUXDB_TIMEOUT=30