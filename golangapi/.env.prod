COMPOSE_ENV_FILE=.env.prod

SERVER_APP_VERSION=v0.0.1
SERVER_PORT=5000
SERVER_MODE=Production
SERVER_PROCESS_TIMEOUT=60
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

LOGGER_ENCODING=console
LOGGER_LEVEL=info

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=db

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=icmon-events
KAFKA_GROUP_ID=icmon-consumer-group
KAFKA_TIMEOUT=30

POSTGRES_CONNECTION_TIMEOUT=10

TASK_REDIS_POOL_TIMEOUT=240

SMTP_EMAIL_TIMEOUT=30

INFLUXDB_TIMEOUT=30
