#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/imageoptim-cli@3.1.9/node_modules/imageoptim-cli/node_modules:/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/imageoptim-cli@3.1.9/node_modules:/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/imageoptim-cli@3.1.9/node_modules/imageoptim-cli/node_modules:/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/imageoptim-cli@3.1.9/node_modules:/mnt/c/xampp/htdocs/tabler-dev/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
"$basedir/../imageoptim-cli/dist/imageoptim"   "$@"
exit $?
